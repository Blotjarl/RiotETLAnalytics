# Riot Games API key. Development keys expire every 24 hours and cannot be
# used for unattended/scheduled runs -- apply for a Personal API key at
# https://developer.riotgames.com/ instead.
RIOT_API_KEY="RGAPI-..."

# Postgres connection string (Supabase: Project Settings -> Database ->
# Connection string -> URI). Used by the ETL job only; the frontend talks to
# Supabase's REST API separately via VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"
